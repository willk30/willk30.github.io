---
layout: default
---
<div class="post waves-home">
  <header class="waves-hero" aria-label="Introduction">
    <canvas class="waves-canvas" id="waves-bg" aria-hidden="true"></canvas>
    <div class="waves-hero-inner">
      <div class="waves-copy">
        <p class="waves-eyebrow">Monterey · Naval Postgraduate School</p>
        <h1 class="waves-name">Will<br /><em>Kirschenman</em></h1>
        <p class="waves-role">Assistant Professor of Operations Research</p>
        <p class="waves-lede">
          I teach OR at NPS, write about AI tools on the side,
          and used to be an Army engineer and analyst.
        </p>
        <nav class="waves-links" aria-label="Site sections">
          <a href="{{ '/research/' | relative_url }}">Research</a>
          <a href="{{ '/teaching/' | relative_url }}">Teaching</a>
          <a href="{{ '/writing/' | relative_url }}">Writing</a>
          <a href="{{ '/cv/' | relative_url }}">CV</a>
          <a href="mailto:{{ site.email }}">Email</a>
        </nav>
      </div>
      {% if page.profile.image %}
        <div class="waves-photo">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class="waves-portrait" sizes="(min-width: 900px) 280px, 70vw" alt="Will Kirschenman" cache_bust=true
          %}
          {% if page.profile.more_info %}
            <div class="waves-photo-meta">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </header>

  <div class="waves-body">
    <article class="waves-about">
      {{ content }}
    </article>

    {% if page.news and site.announcements.enabled %}
      <section class="waves-news" aria-labelledby="news-heading">
        <h2 id="news-heading"><a href="{{ '/news/' | relative_url }}">Recent news</a></h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.social %}
      <div class="social waves-social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </div>
</div>
